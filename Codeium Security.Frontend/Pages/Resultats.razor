@page "/resultats"
@inject AppStateService AppState
@inject MockAnalysisService AnalysisService
@inject ToastService Toasts

<PageTitle>Résultats — Codeium Security</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <div class="page-title">Résultats de l'extraction</div>
            <div class="page-subtitle">Aperçu simulé des transactions extraites du relevé bancaire.</div>
        </div>
        <button class="btn btn-primary" @onclick="ExportExcel">
            <Icon Name="download" Size="17" />
            Exporter Excel
        </button>
    </div>

    <div class="result-summary">
        <div class="summary-item card">
            <span class="summary-label">Banque</span>
            <span class="summary-value">@_result.Banque</span>
        </div>
        <div class="summary-item card">
            <span class="summary-label">Numéro de compte</span>
            <span class="summary-value">@_result.NumeroCompteMasque</span>
        </div>
        <div class="summary-item card">
            <span class="summary-label">Période</span>
            <span class="summary-value">@_result.Periode</span>
        </div>
        <div class="summary-item card">
            <span class="summary-label">Transactions</span>
            <span class="summary-value">@_result.NombreTransactions</span>
        </div>
        <div class="summary-item card">
            <span class="summary-label">Statut</span>
            <span class="summary-value"><StatusBadge Status="_result.Statut" /></span>
        </div>
        <div class="summary-item card">
            <span class="summary-label">Total Débit</span>
            <span class="summary-value text-debit">@_totalDebit.ToString("0.000")</span>
        </div>
        <div class="summary-item card">
            <span class="summary-label">Total Crédit</span>
            <span class="summary-value text-credit">@_totalCredit.ToString("0.000")</span>
        </div>
    </div>

    <div class="card table-card">
        <div class="table-toolbar">
            <div class="search-box">
                <Icon Name="search" Size="16" />
                <input class="input" placeholder="Rechercher un libellé…" @bind="_search" @bind:event="oninput" @bind:after="OnFilterChanged" />
            </div>
            <select class="input filter-select" @bind="_typeFilter" @bind:after="OnFilterChanged">
                <option value="tous">Tous les mouvements</option>
                <option value="debit">Débit uniquement</option>
                <option value="credit">Crédit uniquement</option>
            </select>
        </div>

        @if (_filtered.Count == 0)
        {
            <EmptyState Icon="search" Title="Aucune transaction trouvée" Message="Modifiez votre recherche ou vos filtres." />
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Libellé</th>
                            <th>Débit</th>
                            <th>Crédit</th>
                            <th>Solde</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _paged)
                        {
                            <tr @key="t.Id">
                                <td class="text-muted">@t.Date.ToString("dd/MM/yyyy")</td>
                                <td>@t.Libelle</td>
                                <td class="text-debit">@(t.Debit is { } d ? d.ToString("0.000") : "—")</td>
                                <td class="text-credit">@(t.Credit is { } c ? c.ToString("0.000") : "—")</td>
                                <td>@t.Solde.ToString("0.000")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pagination">
                <span class="pagination-info">Page @_page sur @TotalPages · @_filtered.Count transactions</span>
                <div class="pagination-controls">
                    <button class="btn btn-secondary btn-sm" disabled="@(_page <= 1)" @onclick="() => ChangePage(_page - 1)">Précédent</button>
                    <button class="btn btn-secondary btn-sm" disabled="@(_page >= TotalPages)" @onclick="() => ChangePage(_page + 1)">Suivant</button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private const int PageSize = 8;
    private BankResultViewModel _result = new();
    private decimal _totalDebit;
    private decimal _totalCredit;
    private List<TransactionViewModel> _filtered = new();
    private string _search = "";
    private string _typeFilter = "tous";
    private int _page = 1;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)PageSize));
    private IEnumerable<TransactionViewModel> _paged => _filtered.Skip((_page - 1) * PageSize).Take(PageSize);

    protected override void OnInitialized()
    {
        _result = AppState.CurrentResult ?? AnalysisService.GenerateMockResult(AppState.SelectedDocument);
        AppState.CurrentResult ??= _result;

        // Uniquement SUM(Debit) et SUM(Credit) sur les transactions extraites : aucune
        // validation, aucune comparaison avec un solde, aucune regle metier.
        _totalDebit = _result.Transactions.Sum(t => t.Debit ?? 0m);
        _totalCredit = _result.Transactions.Sum(t => t.Credit ?? 0m);

        ApplyFilters();
    }

    private void OnFilterChanged()
    {
        _page = 1;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        IEnumerable<TransactionViewModel> query = _result.Transactions;

        if (!string.IsNullOrWhiteSpace(_search))
        {
            query = query.Where(t => t.Libelle.Contains(_search, StringComparison.OrdinalIgnoreCase));
        }

        query = _typeFilter switch
        {
            "debit" => query.Where(t => t.Debit is not null),
            "credit" => query.Where(t => t.Credit is not null),
            _ => query
        };

        _filtered = query.ToList();
    }

    private void ChangePage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        _page = page;
    }

    private void ExportExcel() =>
        Toasts.Show("Export simulé — connexion backend à implémenter.", ToastType.Info);
}
