@page "/"

<PageTitle>Dashboard — Codeium Security</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <div class="page-title">Bienvenue dans Codeium Security</div>
            <div class="page-subtitle">Importez un document bancaire pour commencer son analyse.</div>
        </div>
        <a class="btn btn-primary" href="/documents">
            <Icon Name="upload" Size="17" />
            Nouveau document
        </a>
    </div>

    <div class="card recent-card">
        <span class="section-title">Activité récente</span>
        <EmptyState Icon="inbox" Title="Aucun document traité pour le moment."
                    Message="Les documents que vous analyserez apparaîtront ici." />
    </div>
</div>
