<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Codeium_Security</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Le projet de tests xUnit vit dans un sous-dossier de celui-ci ; sans cette exclusion,
         le glob implicite **/*.cs de ce SDK essaierait de compiler ses fichiers ici aussi. -->
    <Compile Remove="Codeium Security.Tests\**" />
    <Content Remove="Codeium Security.Tests\**" />
    <None Remove="Codeium Security.Tests\**" />
    <EmbeddedResource Remove="Codeium Security.Tests\**" />

    <!-- Le projet frontend Blazor (Codeium Security.Frontend) vit aussi dans un sous-dossier
         de celui-ci ; meme exclusion que ci-dessus, sinon le glob implicite de ce SDK
         essaierait de compiler ses fichiers .cs/.razor ici aussi. -->
    <Compile Remove="Codeium Security.Frontend\**" />
    <Content Remove="Codeium Security.Frontend\**" />
    <None Remove="Codeium Security.Frontend\**" />
    <EmbeddedResource Remove="Codeium Security.Frontend\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.13" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="MachineLearning\" />
    <Folder Include="Logs\" />
    <Folder Include="FeatureExtraction\" />
    <Folder Include="Images\" />
    <Folder Include="RawResults\" />
    <Folder Include="Output\" />
    <Folder Include="TrainingData\SourceDocuments\" />
    <Folder Include="TrainingData\RawResults\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tessdata\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
